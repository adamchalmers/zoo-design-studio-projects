// Hex Nut with Chamfered Ends and Through-Hole
// This model generates a hexagonal nut with: a hex exterior defined by across-flats dimension, circular chamfers applied to both end faces, and central through-hole
// Categories: Fasteners

// Set Units
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// ──────────
// PARAMETERS
// ──────────
// Primary nut dimensions
nutAcrossCorners = 20 // Across-corners distance of the hex
nutThickness = 10 // Overall thickness of the nut (extrusion length)
hexCircumscribedRadius = nutAcrossCorners / 2 // Radius to hex vertices for a regular 6-sided polygon


// Chamfer control
chamferCircleRadius = hexCircumscribedRadius * 1.1 // Radius of the auxiliary circular solid used to define chamfer edges
chamferLength = 3.5 // Chamfer setback distance along the end edges


// Hole control
holeRadius = 4 // Radius of the central through-hole


sketch002 = sketch(on = XY) {
  // Internal hole through the center.
  circleHole = circle(start = [var -0.1in, var 0.12in], center = [var 0in, var 0in])
  coincident([circleHole.center, ORIGIN])
  distance([circleHole.start, circleHole.center]) == holeRadius

  toChamfer = circle(start = [var 10.55mm, var 9.34mm], center = [var 0mm, var 0mm])
  coincident([toChamfer.center, ORIGIN])
  distance([toChamfer.center, toChamfer.start]) == chamferCircleRadius
}

hexagonSketch = sketch(on = XY) {
  // Six diagonals, between opposite corners.
  line1 = line(start = [var 0mm, var 0mm], end = [var -5mm, var 8.66mm], construction = true)
  coincident([line1.start, ORIGIN])
  line2 = line(start = [var 0mm, var 0mm], end = [var 5mm, var 8.66mm], construction = true)
  coincident([line2.start, line1.start])
  line3 = line(start = [var 0mm, var 0mm], end = [var 10mm, var 0mm], construction = true)
  coincident([line3.start, line2.start])
  verticalDistance([line3.end, ORIGIN]) == 0in
  line4 = line(start = [var 0mm, var 0mm], end = [var 5mm, var -8.66mm], construction = true)
  coincident([line4.start, line3.start])
  line5 = line(start = [var 0mm, var 0mm], end = [var -5mm, var -8.66mm], construction = true)
  coincident([line5.start, line4.start])
  line6 = line(start = [var 0mm, var 0mm], end = [var -10mm, var 0mm], construction = true)
  coincident([line6.start, line5.start])
  verticalDistance([line6.end, ORIGIN]) == 0in
  // All diagonals should be equal length.
  equalLength([
    line1,
    line2,
    line3,
    line4,
    line5,
    line6
  ])
  // Six external edges.
  line7 = line(start = [var -10mm, var 0mm], end = [var -5mm, var 8.66mm])
  coincident([line7.start, line6.end])
  coincident([line7.end, line1.end])
  line8 = line(start = [var -5mm, var 8.66mm], end = [var 5mm, var 8.66mm])
  coincident([line8.start, line7.end])
  coincident([line8.end, line2.end])
  line9 = line(start = [var 5mm, var 8.66mm], end = [var 10mm, var 0mm])
  coincident([line9.start, line2.end])
  coincident([line9.end, line3.end])
  line10 = line(start = [var 10mm, var 0mm], end = [var 5mm, var -8.66mm])
  coincident([line10.start, line3.end])
  coincident([line10.end, line4.end])
  line11 = line(start = [var 5mm, var -8.66mm], end = [var -5mm, var -8.66mm])
  coincident([line11.start, line4.end])
  coincident([line11.end, line5.end])
  line12 = line(start = [var -5mm, var -8.66mm], end = [var -10mm, var 0mm])
  coincident([line12.start, line11.end])
  coincident([line12.end, line7.start])
  // Edges are all equal length.
  equalLength([
    line12,
    line11,
    line10,
    line9,
    line8,
    line7
  ])
  // The 6 edges form 3 pairs of parallel lines.
  parallel([line11, line8])
  parallel([line7, line10])
  parallel([line12, line9])
  distance([line5.start, line5.end]) == hexCircumscribedRadius
}

chamferRegion = region(point = [-8.2342587mm, -7.2898553mm], sketch = sketch002)
chamferSolid = extrude(
       chamferRegion,
       length = nutThickness,
       tagStart = $chamferStartFace,
       tagEnd = $chamferEndFace,
       symmetric = true,
     )
  |> appearance(color = "#da7333", roughness = 50, metalness = 90)
  |> chamfer(
       tags = [
         getCommonEdge(faces = [
           chamferRegion.tags.toChamfer,
           chamferEndFace
         ]),
         getCommonEdge(faces = [
           chamferRegion.tags.toChamfer,
           chamferStartFace
         ])
       ],
       length = chamferLength,
     )

hexRegion = region(point = [0, 2mm], sketch = hexagonSketch)
nutSolid = extrude(hexRegion, length = nutThickness, symmetric = true)
  |> appearance(color = "#0040ff", metalness = 90, roughness = 40)

nutWithChamfer = intersect([nutSolid, chamferSolid])
sketch001 = sketch(on = XZ) {
  line1 = line(start = [var -3.16mm, var 5.55mm], end = [var -3.98mm, var -7.48mm])
  line2 = line(start = [var -4.36mm, var -6.24mm], end = [var 2.99mm, var -2.33mm])
  coincident([line1.end, line2.start])
  line3 = line(start = [var 2.65mm, var 1.28mm], end = [var 7.82mm, var 6.49mm])
  coincident([line2.end, line3.start])
  line4 = line(start = [var 7.82mm, var 6.49mm], end = [var -3.16mm, var 5.55mm])
  coincident([line3.end, line4.start])
  coincident([line4.end, line1.start])
  parallel([line4, line2])
  circle1 = circle(start = [var 8.69mm, var 5.65mm], center = [var 0mm, var 0mm])
  coincident([circle1.center, ORIGIN])
}
